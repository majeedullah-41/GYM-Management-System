# Gym POS License Server Environment Variables
# Copy this file to .env or .env.local and set your secret values:

# 1. Vendor Secret Key (Password you type into the web generator)
LICENSE_VENDOR_KEY=your_chosen_vendor_password_here

# 2. Private Ed25519 Signing Seed (32 bytes base64)
# Generated using `cargo run --bin license-generator -- gen-keys`
LICENSE_PRIVATE_KEY=
